{
  "globalHeaders": {
    "Cache-Control": "no-cache, no-store, must-revalidate",
    "Pragma": "no-cache",
    "Expires": "0"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/data.json",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.svg",
      "/*.ico",
      "/last.html",
      "/favicon.ico",
      "/favicon.png",
      "/favicon-16.png",
      "/favicon-32.png",
      "/favicon-48.png",
      "/apple-touch-icon.png",
      "/icon-512.png",
      "/assets/*"
    ]
  }
}
